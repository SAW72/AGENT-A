# Base Sepolia claim-flow relayer. Copy to .env locally. Never commit real values.
# This service does not read a key file and does not write RELAYER_PRIVATE_KEY to disk.
# Defaults are fixture / dry-run. LIVE_SUBMIT and SPENCER_RUN_AUTH stay 0.

# Public RPC used only when live submit is unlocked. Do not put a key in the URL.
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Must stay 84532. Any other chain, including Ethereum mainnet (1) and Base mainnet (8453), is refused.
CHAIN_ID=84532

# Public hot wallet only. Default if unset: 0x9D1b3E1400D2632d435cB7C0fC131C4f42B31861
# Funding-only address. Do not put a private key here.
RELAYER_ADDRESS=0x9D1b3E1400D2632d435cB7C0fC131C4f42B31861

# Runtime secret. Export in the process environment (shell or Render dashboard).
# Read only when live submit is allowed. Never logged and never written to disk.
RELAYER_PRIVATE_KEY=

# Optional override. When empty, the service loads BotAttestationEscrow from
# deployments/base-sepolia.json (Base Sepolia only). Set the zero address to force
# escrowBooked=false. Do not point this at mainnet.
# Booked address: 0x1069aA6597f08F1E8B8ad39AA40EDE1D0c77298d
# Retired escrow 0x141214F04b0E1d949B6e6bf32D019Ad7Ab5B284c is refused at boot, any case.
# Superseded Denylist and Vault addresses are refused too.
ESCROW_ADDRESS=

# Used only when ESCROW_ADDRESS is a different contract than the booked escrow.
# The booked start block 47345163 is not applied to that other contract.
# Leave empty to boot with escrowStartBlock unset (see /health and the startup log).
# Unset is not block 0. A non-integer or negative value refuses to boot.
# ESCROW_START_BLOCK=

# Gates POST /v1/admin/pause and /v1/admin/unpause.
# When empty those routes are a documented no-op (they do not change the kill switch).
# Do not reuse this value as the live-claim secret.
ADMIN_SECRET=

# Shared secret for POST /v1/claims when the client asks for a live submit and the
# live gate is open (LIVE_SUBMIT=1 and SPENCER_RUN_AUTH=1 on the booked Sepolia escrow).
# Send it as x-claim-secret or Authorization: Bearer. This is not ADMIN_SECRET.
# Fixture claims and quotes do not use it. If live submit is allowed and this is
# empty, live claims fail closed with 503 claim_api_secret_required and nothing is broadcast.
CLAIM_API_SECRET=

# Browser origins allowed to call this service. Comma-separated, no trailing slash.
# Include the Wallet UX Pages origin when that app posts live claims.
# CORS_ORIGINS=https://agent-a-wallet-ux.pages.dev,http://localhost:5173,http://127.0.0.1:5173

# Initial kill switch. Health stays HTTP 200. Quote and claim routes return 503 kill_switch.
KILL_SWITCH=0

# Sepolia live path. Default OFF. Set both to 1, with CHAIN_ID=84532, to unlock
# claim broadcasts to the booked Base Sepolia escrow. Either flag alone stays blocked.
# Never set these for Ethereum mainnet (1) or Base mainnet (8453). Those chains refuse to boot.
LIVE_SUBMIT=0
SPENCER_RUN_AUTH=0

# Append-only JSONL of quote/claim attempts. No private keys. Render disk is ephemeral.
CLAIM_LOG_PATH=./data/claims.jsonl

PORT=8790
# Render sets PORT and should set HOST=0.0.0.0. Local default is 127.0.0.1.
# HOST=127.0.0.1
